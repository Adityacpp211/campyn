# CAMPYN V2 — Environment Configuration Template
# Copy this file to .env and configure for your local/deployment environment

# Environment Mode: development | staging | production
NODE_ENV=development

# Server Port
PORT=3001

# Server Host — 0.0.0.0 allows access from other devices (LAN, tunnel)
# Use 127.0.0.1 to restrict to local machine only
HOST=0.0.0.0

# JSON Web Token Secret Key (Must be at least 32 characters in production)
JWT_SECRET=campyn-development-secret-jwt-key-2026-change-in-production

# Cryptographic Audit Salt (Used for SHA-256 blockchain tamper-detection)
AUDIT_SALT=campyn-audit-salt-production-secure-hash-salt-2026

# Relational Database Connection URL (Leave blank to use embedded PostgreSQL 16 engine)
# For Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Example local: postgresql://campyn_user:campyn_pass@localhost:5432/campyn_production
DATABASE_URL=

# CORS Allowed Origin — Use * to allow all, or comma-separated list of origins
# For tunnel: CORS_ORIGIN=https://your-tunnel-url.trycloudflare.com,http://localhost:5173
CORS_ORIGIN=*

# Frontend API URL (only needed for Electron desktop builds pointing to remote server)
# VITE_API_URL=https://your-tunnel-url.trycloudflare.com/api/v1
